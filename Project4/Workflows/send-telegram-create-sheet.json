    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO public.order_delivery_sheets (\n    order_id,\n    order_code,\n    sheet_name,\n    sheet_id,\n    row_number\n)\nSELECT\n    o.id,\n    o.order_code,\n    $2,\n    $3::BIGINT,\n    $4::INTEGER\nFROM public.orders o\nWHERE o.order_code = $1\n\nON CONFLICT (order_id)\nDO UPDATE SET\n    order_code = EXCLUDED.order_code,\n    sheet_name = EXCLUDED.sheet_name,\n    sheet_id = EXCLUDED.sheet_id,\n    row_number = EXCLUDED.row_number\n\nRETURNING *;",
        "options": {
          "queryReplacement": "={{\n[\n  $('Append or update row in sheet').first().json['كود التخزين'],\n  $json.sheet_name,\n  $json.sheet_id,\n  $('Get row(s) in sheet1').isExecuted &&  $('Get row(s) in sheet1').first().json.row_number != null\n    ? $('Get row(s) in sheet1').first().json.row_number\n    : 2\n]\n}}"
        }
