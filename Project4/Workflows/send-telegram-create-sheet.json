{
  "name": "Send telegram , create sheet (first)",
  "nodes": [
    {
      "parameters": {
        "jsCode": "\n// =====================================\n// 1. Get source data\n// =====================================\n\nconst sheetcode = $('code').first().json['كود'];\nconst order = $('get order details').first().json;\nconst groups = $('get groups id').all();\nconst imageRows = $('get images key').all();\n\nconst R2_PUBLIC_URL =\n  'https://pub-d3ad27f3192a413db6127f958dec3be5.r2.dev';\n\nconst summary = order.order_summary || '';\n\nconst ifData = $('if record exist').isExecuted\n  ? $('if record exist').first()?.json ?? {}\n  : {};\n\n// إضافة كود الشيت في أول ملخص الطلب\nconst fullSummary = `🔖 كود الشيت: ${sheetcode}\\n${summary}`;\n\n\n// =====================================\n// 2. Filter valid images\n// =====================================\n\nconst validImages = imageRows\n  .map(item => item.json)\n  .filter(img =>\n    img.is_active === true &&\n    !img.deleted_at &&\n    img.object_key\n  );\n\n// Cake images only\nconst cakeImages = validImages.filter(\n  img => img.image_type === 'cake'\n);\n\n// All images for delivery\nconst deliveryImages = validImages;\n\n\n// =====================================\n// 3. Build cake caption\n// =====================================\n\nconst lines = summary.split(/\\r?\\n/);\n\nconst cakeDetails = lines.filter(line =>\n  /^(نوع الكيكة والحجم|الحشو|التغطية|تفاصيل إضافية|التوابع):/.test(\n    line.trim()\n  )\n);\n\nconst formattedDate =\n  $('Code in JavaScript1').first().json.formatted_date;\n\n\n// =====================================\n// 4. Format delivery time\n// =====================================\n\nconst deliveryTimeFrom = order.delivery_time_from;\nconst deliveryTimeTo = order.delivery_time_to;\n\nconst isLastTime = [\n  'last',\n  'اخر معاد',\n  'آخر معاد'\n].includes(String(deliveryTimeFrom || '').trim());\n\nconst deliveryTime = isLastTime\n  ? 'اخر معاد'\n  : [\n      deliveryTimeFrom,\n      deliveryTimeTo\n    ]\n      .filter(time =>\n        time !== null &&\n        time !== undefined &&\n        String(time).trim() !== ''\n      )\n      .join(' - ');\n\n\n// =====================================\n// 5. Build cake caption\n// =====================================\n\nconst cakeCaption = [\n  '🎂 تفاصيل طلب الكيك',\n  '',\n  ...cakeDetails,\n  '',\n  `📅 يوم التسليم: ${formattedDate}`,\n  `⏰ وقت التسليم: ${deliveryTime || 'غير محدد'}`\n].join('\\n');\n\n\n// =====================================\n// 6. Build Telegram media\n// =====================================\n\nfunction buildMedia(images, caption) {\n  return images.map((img, index) => ({\n    type: 'photo',\n    media: `${R2_PUBLIC_URL}/${img.object_key}`,\n    ...(index === 0 ? { caption } : {})\n  }));\n}\n\n\n// =====================================\n// 7. Prepare separate requests\n// =====================================\n\nconst requests = [];\n\nfor (const groupItem of groups) {\n\n  const group = groupItem.json;\n\n  const groupName = String(group.groupName || '');\n\n  const isCakeGroup = groupName.includes('كيك');\n  const isDeliveryGroup = groupName.includes('توصيل');\n\n  if (!isCakeGroup && !isDeliveryGroup) {\n    continue;\n  }\n\n  const selectedImages = isCakeGroup\n    ? cakeImages\n    : deliveryImages;\n\n  if (selectedImages.length === 0) {\n    throw new Error(\n      `No images found for group: ${groupName}`\n    );\n  }\n\n  const cakeCaptionWithCode = [\n    `🔖 كود الشيت: ${sheetcode}`,\n    '',\n    cakeCaption\n  ].join('\\n');\n\n  const caption = isCakeGroup\n    ? cakeCaptionWithCode\n    : fullSummary;\n\n  requests.push({\n    json: {\n      chat_id: String(group.groupId),\n      media: buildMedia(selectedImages, caption),\n      group_type: isCakeGroup ? 'cake' : 'delivery'\n    }\n  });\n}\n\nreturn requests;\n"
      },
