    {
      "parameters": {
        "jsCode": "\n// ==========================================\n// 1. Get Telegram Responses\n// ==========================================\nconst responses = $input.all();\n\n// ==========================================\n// 2. Get Order Details\n// ==========================================\nconst order = $('get order details').first().json;\nconst orderId = Number(order.id);\n\nif (!orderId) {\n  throw new Error('Order ID is missing');\n}\n\n// ==========================================\n// 3. Process Telegram Responses\n// ==========================================\nconst rows = [];\n\nfor (const response of responses) {\n\n  const result = response.json.result;\n\n  if (!Array.isArray(result) || result.length === 0) {\n    throw new Error('Invalid or empty Telegram response');\n  }\n\n  // Get group information\n  const firstMessage = result[0];\n  const chatId = String(firstMessage.chat.id);\n  const chatTitle = firstMessage.chat.title || '';\n\n  // Identify group type using Telegram group title\n  let groupType;\n\n  if (chatTitle.includes('كيك')) {\n    groupType = 'cake';\n  } else if (chatTitle.includes('توصيل')) {\n    groupType = 'delivery';\n  } else {\n    throw new Error(\n      `Unknown group type. Chat title: ${chatTitle}`\n    );\n  }\n\n  // Extract all message IDs\n  for (const message of result) {\n\n    rows.push({\n      json: {\n        order_id: orderId,\n        telegram_chat_id: String(message.chat.id),\n        telegram_message_id: Number(message.message_id),\n        group_type: groupType\n      }\n    });\n\n  }\n}\n\n// ==========================================\n// 4. Return PostgreSQL Records\n// ==========================================\nreturn rows;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
