    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst order = $('Code in JavaScript1').first().json;\n\n// استخراج اليوم من تاريخ الأوردر\n// مثال: 2026-11-11 → 11\nconst orderDate = String(order.delivery_date).trim();\nconst day = orderDate.split('-')[2];\n\n// Prefix مثال: L11\nconst prefix = `L${day}`;\n\nlet lastOrder = 0;\n\n// البحث من آخر صف إلى أول صف\nfor (let i = rows.length - 1; i >= 0; i--) {\n  const code = String(rows[i].json['كود'] || '').trim();\n\n  const match = code.match(/^L(\\d{2})(\\d{2})$/);\n\n  if (match && match[1] === day) {\n    lastOrder = Number(match[2]);\n    break;\n  }\n}\n\n// زيادة الترتيب\nconst nextOrder = String(lastOrder + 1).padStart(2, '0');\n\nconst orderCode = `${prefix}${nextOrder}`;\n\nreturn [\n  {\n    json: {\n      orderCode,\n      ...order\n    }\n  }\n];"
      },
