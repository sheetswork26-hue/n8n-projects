      "parameters": {
        "jsCode": "\nconst items = $('Webhook').all();\nconst results = [];\nconst seen = new Set();\nfor (const input of items) {\n  const root = input.json.body || input.json;\n\n  // Meta sends Page events inside entry[]\n  const entries = root.entry || [];\n\n  for (const entry of entries) {\n    const pageId = String(entry.id || '');\n    const changes = entry.changes || [];\n\n    for (const change of changes) {\n      const v = change.value || {};\n\n      const commentId = String(v.comment_id || '');\n      const postId = String(v.post_id || '');\n      const fromId = String(v.from?.id || '');\n      const message = String(v.message || '').trim();\n\n      if (v.item !== 'comment' || v.verb !== 'add') continue;\n      if (!commentId || !postId || !message) continue;\n\n      // Ignore comments made by the page itself\n      if (fromId === pageId) continue;\n\n      const uniqueKey = `${pageId}_${commentId}`;\n      if (seen.has(uniqueKey)) continue;\n      seen.add(uniqueKey);\n\n      results.push({\n        json: {\n          pageId,\n          commentId,\n          postId,\n          parentId: v.parent_id || null,\n          commenterId: fromId,\n          commenterName: v.from?.name || 'عميلنا',\n          commentText: message,\n          createdTime: v.created_time,\n          postPermalink: v.post?.permalink_url || null,\n         \n          rawPayload: entry\n        }\n      });\n    }\n  }\n}\n\nreturn results;\n"
