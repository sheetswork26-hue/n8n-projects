    {
      "parameters": {
        "jsCode": "const req = $('Webhook').first().json.body ?? {};\nconst code = String(req.orderCode ?? '').trim().toLowerCase();\nconst normalizePhone = value => { const digits = String(value ?? '').replace(/\\D/g, ''); return digits.length === 10 && /^1[0125]/.test(digits) ? `0${digits}` : digits; };\nconst phone = normalizePhone(req.phone);\nconst rows = $input.all().map(item => item.json);\nconst found = rows.find(row =>\n  String(row.orderCode ?? '').trim().toLowerCase() === code &&\n  normalizePhone(row.phone) === phone\n);\nif (!found) {\n  return [{ json: { success: false, message: 'لم يتم العثور على طلب مطابق لكود الطلب ورقم الموبايل.' } }];\n}\nreturn [{ json: { success: true, order: found } }];"
      },
