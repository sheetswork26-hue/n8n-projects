      "parameters": {
        "jsCode": "const req = $('Webhook').first().json.body ?? {};\nconst code = String(req.orderCode ?? '').trim().toLowerCase();\nconst normalizePhone = value => { const digits = String(value ?? '').replace(/\\D/g, ''); return digits.length === 10 && /^1[0125]/.test(digits) ? `0${digits}` : digits; };\nconst phone = normalizePhone(req.searchPhone ?? req.phone);\nconst rows = $input.all().map(item => item.json);\nconst found = rows.find(row =>\n  String(row.orderCode ?? '').trim().toLowerCase() === code &&\n  normalizePhone(row.phone) === phone\n);\nif (!found) return [{ json: { found: false, success: false, message: 'لم يتم العثور على طلب مطابق. لم يتم حفظ أي تعديل.' } }];\nconst months = {\n  'يناير':['January','يناير'],'فبراير':['February','فبراير'],'مارس':['March','مارس'],\n  'أبريل':['April','أبريل'],'ابريل':['April','أبريل'],'مايو':['May','مايو'],'يونيو':['June','يونيو'],\n  'يوليو':['July','يوليو'],'أغسطس':['August','أغسطس'],'اغسطس':['August','أغسطس'],\n  'سبتمبر':['September','سبتمبر'],'أكتوبر':['October','أكتوبر'],'اكتوبر':['October','أكتوبر'],\n  'نوفمبر':['November','نوفمبر'],'ديسمبر':['December','ديسمبر']\n};\nconst getMonth = dateText => {\n  const text = String(dateText ?? '');\n  const month = text.match(/يناير|فبراير|مارس|أبريل|ابريل|مايو|يونيو|يوليو|أغسطس|اغسطس|سبتمبر|أكتوبر|اكتوبر|نوفمبر|ديسمبر/)?.[0];\n  if (month) return { name: months[month][0], arabic: months[month][1] };\n  const iso = text.match(/^\\d{4}-(\\d{2})-\\d{2}$/);\n  const isoMonths = {'01':['January','يناير'],'02':['February','فبراير'],'03':['March','مارس'],'04':['April','أبريل'],'05':['May','مايو'],'06':['June','يونيو'],'07':['July','يوليو'],'08':['August','أغسطس'],'09':['September','سبتمبر'],'10':['October','أكتوبر'],'11':['November','نوفمبر'],'12':['December','ديسمبر']};\n  return iso ? {name: isoMonths[iso[1]][0], arabic: isoMonths[iso[1]][1]} : {name:'',arabic:''};\n};\nconst oldMonth = getMonth(found.deliveryDate);\nconst newMonth = getMonth(req.deliveryDate);\nif (!newMonth.name) return [{ json: { found: false, success: false, message: 'تاريخ التسليم الجديد غير صالح.' } }];\nreturn [{ json: { found: true, success: true, orderCode: code, oldMonth: oldMonth.name, oldMonthArabic: oldMonth.arabic, newMonth: newMonth.name, newMonthArabic: newMonth.arabic } }];"
      },
